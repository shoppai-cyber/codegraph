    "idnameRules": [
      {
        "id": "operator-explicit-dotted-idname",
        "scope": [
          "Operator"
        ],
        "attribute": "bl_idname",
        "required": true,
        "derivation": "No automatic derivation is assumed; the literal dotted idname is authoritative. Class names normally follow CATEGORY_OT_name but that is convention-only and never a resolution source (SYNTHESIS rule 3; REVIEW_r1 bug 9 — the r1 inference fallback is removed in r2).",
        "examples": [
          "bl_idname = \"wm.hello_world\"",
          "bpy.ops.wm.hello_world()"
        ],
        "provenance": [
          "01_CATALOG_LOCAL.md#C2",
          "SYNTHESIS.md#2-X2"
        ],
        "validated": [
          "VAL-001"
        ]
      },
      {
        "id": "ui-class-default-idname",
        "scope": [
          "Panel",
          "Menu",
          "Header",
          "UIList"
        ],
        "attribute": "bl_idname",
        "required": false,
        "derivation": "If absent, the class name is the idname. Runtime equivalent: registerableBases.<base>.idname.default === 'className'.",
        "provenance": [
          "01_CATALOG_LOCAL.md#D1",
          "01_CATALOG_LOCAL.md#D2",
          "01_CATALOG_LOCAL.md#D3",
          "01_CATALOG_LOCAL.md#D4"
        ],
        "validated": [
          "VAL-002"
        ]
      },
      {
        "id": "addon-preferences-package-idname",
        "scope": [
          "AddonPreferences"
        ],
        "attribute": "bl_idname",
        "required": true,
        "derivation": "Package/module name; for extensions use __package__.",
        "provenance": [
          "01_CATALOG_LOCAL.md#M1",
          "01_CATALOG_LOCAL.md#extensions-3.2"
        ],
        "validated": [
          "VAL-003.AddonPreferences-mismatch"
        ]
      },
      {
        "id": "computed-idname-no-guess",
        "scope": [
          "all-registerable-bases"
        ],
        "attribute": "bl_idname",
        "required": "depends-on-base",
        "derivation": "Computed expressions, f-strings, concatenation, or __package__ expressions are not guessed. r2 emits NOTHING for them (no idname mapping, no node) — informational diagnostic nodes were removed per the r2 ruling that no sibling resolver pollutes listings with non-invocation nodes.",
        "provenance": [
          "02_PATTERNS_LOCAL.md#ranking-3",
          "01_CATALOG_LOCAL.md#C2",
          "REVIEW_r1.md ruling 2"
        ],
        "validated": []
      }
