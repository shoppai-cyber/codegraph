  "propertyCallbacks": {
    "description": "Keyword arguments of bpy.props.*Property(...) calls that register runtime callbacks (function_ref) or type linkage (references). Consumed by both the property-injection path (bpy.types.T.attr = ...) and the generic in-class annotation path.",
    "callbackKwargs": [
      "update",
      "get",
      "set",
      "get_transform",
      "set_transform",
      "search",
      "poll",
      "items"
    ],
    "enumItemsKwarg": "items",
    "typeReferenceKwargs": [
      "type"
    ],
    "referenceKind": "function_ref for callbackKwargs; references for typeReferenceKwargs",
    "resolverNotes": [
      "items= is a callback only when the value is a callable name; tuple/list/dict literals are static enum data (falsePositiveGuards.no-static-enum-items-callback).",
      "type= emits a references edge only for a plain capitalized class name that is not bpy.*-prefixed; loop variables and builtin RNA types are skipped (false-positive-safe)."
    ],
    "provenance": [
      "01_CATALOG_LOCAL.md#E1",
      "01_CATALOG_LOCAL.md#E2",
      "01_CATALOG_LOCAL.md#E3",
      "01_CATALOG_LOCAL.md#E4",
      "01_CATALOG_LOCAL.md#E5",
      "01_CATALOG_LOCAL.md#E6",
      "02_PATTERNS_LOCAL.md#G",
      "02_PATTERNS_LOCAL.md#ranking-4"
    ],
    "validated": [
      "SYNTHESIS.md#timing (GPT-DR primary read: bpy.props update/get/set/items/poll/search kwargs are stored as real RNA callback hooks)"
    ]
  },
  "operatorIdnameValidation": {
    "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
    "rule": "Operator idnames are lowercase [a-z0-9_.] with exactly one dot (category.name). A string failing validation at an operator call site (bpy.ops path, UILayout.operator*, keymap_items.new, target_set_operator, Macro.define) emits nothing: no idname reference and no node. Non-operator idnames (Panel/Menu/Header/UIList bl_idname, bl_parent_id) follow the class-name convention and are NOT subject to this charset rule.",
    "provenance": [
      "SYNTHESIS.md#2-X2",
      "REVIEW_r1.md gap (b)"
    ],
    "validated": [
      "SYNTHESIS.md 3/3 providers; Blender WM core WM_operator_py_idname charset rules (canonical wm_operators.cc)"
    ]
  },
  "manifest": {
    "fileName": "blender_manifest.toml",
    "idField": "id",
    "typeField": "type",
    "skipExtractionForTypes": [
      "theme"
    ],
    "virtualPackagePrefix": "bl_ext",
    "rule": "The manifest id defines the extension's virtual import package root bl_ext.{repository_module}.{id}; the repository module segment is host-configured and statically unknowable, so resolution matches the id segment against the manifest and maps the remaining dotted path against the manifest's directory. The manifest carries metadata and import-root identity only — it contributes NO callback or entry-point linkage. type == \"theme\" disables Python invocation extraction for the project.",
    "provenance": [
      "SYNTHESIS.md#RQ4",
      "SYNTHESIS.md#2-X1",
      "SYNTHESIS.md verdict rule 1 and rule 2"
    ],
    "validated": [
      "SYNTHESIS.md 3/3 providers on bl_ext.{repo}.{id}; Gemini import-resolution consequence adjudicated as additive"
    ]
  },
